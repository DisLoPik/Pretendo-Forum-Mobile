<?xml version="1.0" encoding="utf-8"?>
<!--
    Only for host tests. Robolectric launches a real activity to host a composition, and a
    library module has none of its own, so the bare ComponentActivity is declared here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />
    </application>
</manifest>
